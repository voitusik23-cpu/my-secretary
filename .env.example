# Ключ Gemini API из Google AI Studio (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Секретный ключ для защиты API и авторизации в PWA и Apple Shortcuts
SECRET_KEY=change_this_to_a_secure_password_or_token

# 32-байтный ключ Fernet для прозрачного шифрования базы данных SQLite
# Сгенерировать: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Настройки сервера
HOST=0.0.0.0
PORT=8000
DATABASE_URL=sqlite:///./secretary.db
